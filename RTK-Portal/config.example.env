# Copy to .env (never commit it) and load with: set -a; . ./.env; set +a

# Where rtk.db (requests, log), kg.db (knowledge graph index) and outbox/ live.
RTK_DATA_DIR=data
# Long random string; keep it stable or every session ends on restart.
# python3 -c "import secrets; print(secrets.token_hex(32))"
RTK_SECRET_KEY=change-me
# Public address of the portal, used in emails and search links.
RTK_BASE_URL=https://rtk.example.org
# Where the Meeting Navigator pages are served.
RTK_NAVIGATOR_URL=https://csbmn.claremontv.org/
# Checkout of https://github.com/kevin-tyson/CSBMN, for the index build.
RTK_REPO_PATH=/srv/CSBMN

# Staff who may sign in to the console (comma-separated).
RTK_STAFF_EMAILS=custodian@sau6.org

# Mail: outbox (writes .eml files to data/outbox), smtp, or console.
RTK_MAIL_BACKEND=smtp
RTK_MAIL_FROM="SAU 6 Right-to-Know <rtk@sau6.org>"
RTK_SMTP_HOST=smtp.example.org
RTK_SMTP_PORT=587
RTK_SMTP_USER=
RTK_SMTP_PASSWORD=
RTK_SMTP_STARTTLS=true

# Triage by Claude. Leave empty to use the rules engine only.
RTK_ANTHROPIC_API_KEY=
RTK_CLAUDE_MODEL=claude-sonnet-5-5

# Names and wording.
RTK_DISTRICT_NAME="Claremont School District"
RTK_OPERATOR="Claremont Community Television (CCTV) / Claremont Community Media Center (CCMC)"
RTK_SIGNATURE="Office of the Superintendent, SAU 6\nRecords custodian under Claremont School Board Policy EH"

# Behind a reverse proxy that terminates TLS:
RTK_HTTPS_ONLY=true
RTK_TRUST_PROXY=true
# Networks allowed to reach the staff console (CIDR, comma-separated). Empty allows any.
RTK_STAFF_ALLOWED_IPS=

# Optional limits.
# RTK_OTP_TTL_MINUTES=10
# RTK_OTP_MAX_ATTEMPTS=5
# RTK_MAX_REQUEST_CHARS=5000
# RTK_PENDING_TTL_HOURS=24
# RTK_MIN_CELL_SIZE=10
# RTK_CONTACT_RETENTION_DAYS=0
